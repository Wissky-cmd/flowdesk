# Use a random URL-safe password; never commit the real .env.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# Production: terminate trusted HTTPS before Nginx, set COOKIE_SECURE=true,
# exact HTTPS origins, and forward the trusted original scheme.
