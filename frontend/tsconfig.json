{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "preserve", "resolveJsonModule": true, "isolatedModules": true,
    "esModuleInterop": true, "lib": ["ES2022", "DOM"], "skipLibCheck": true,
    "types": ["vite/client", "node"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "*.ts", "tests/**/*.ts"]
}
