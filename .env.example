DATABASE_URL=postgresql+psycopg://flowdesk:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/flowdesk
TEST_DATABASE_URL=postgresql+psycopg://flowdesk:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/flowdesk_test
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Only false for local HTTP development. Set true behind HTTPS in production.
COOKIE_SECURE=false
SESSION_HOURS=12
REDIS_URL=redis://127.0.0.1:6379/0
BROKER_URL=redis://127.0.0.1:6379/1
# Set false only for local development without Redis; Compose enables protection.
RATE_LIMIT_ENABLED=true
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=60
# Optional dedicated disposable Redis DB for live integration tests.
# TEST_REDIS_URL=redis://127.0.0.1:6379/15
