        "operationId": "create_ticket_api_v1_workspaces__wid__tickets_post",
        "parameters": [
          {
            "name": "wid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Wid"
            }
          },
          {
            "name": "idempotency-key",
